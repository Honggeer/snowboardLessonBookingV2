# Public parameters and paths only. Actual credentials live in protected files.
BACKEND_IMAGE=
FRONTEND_IMAGE=
APP_PUBLIC_URL=https://lessons.example.test
SECRETS_DIR=/etc/snowboard-v2/secrets
TLS_DIR=/etc/snowboard-v2/tls
ACME_DIR=/var/lib/snowboard-v2/acme
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_FROM=
MEDIA_STAGING_BUCKET=
MEDIA_FROZEN_BUCKET=
MEDIA_CDN_BASE_URL=
MEDIA_KEY_PAIR_ID=

# Non-secret controls: pause reminders only, or all booking emails before rollback.
BOOKING_REMINDERS_ENABLED=true
BOOKING_MAIL_WORKER_ENABLED=true
